# VPC CIDR block
vpc_cidr_block = "10.0.0.0/16"

# Public subnets
public_1a = "10.0.1.0/24"
public_1b = "10.0.2.0/24"

# Private subnets
private_1a = "10.0.3.0/24"
private_1b = "10.0.4.0/24"

# Availability zones
availability_zone_1a = "us-west-1a"
availability_zone_1b = "us-west-1c"

# Database Name
rds_database_name = "cloudplatformkitrds"
rds_database_username = "dbadmin"
rds_database_password = "ReplaceWithSecurePassword123"

# Application secret and immutable ECR image URIs
api_gateway_api_key             = "ReplaceWithSecureAPIKey"
api_gateway_image_uri           = "<account-id>.dkr.ecr.us-west-1.amazonaws.com/api-gateway:<commit-sha>"
vulnerability_scanner_image_uri = "<account-id>.dkr.ecr.us-west-1.amazonaws.com/vulnerability-scanner:<commit-sha>"

# Grafana Cloud OpenTelemetry configuration
grafana_otlp_endpoint = "https://otlp-gateway-<region>.grafana.net/otlp"
grafana_otlp_headers  = "Authorization=Basic <base64-instance-id-and-token>"